PORT=5000
DB_USER=
DB_PW=
# Absolute path to a Firebase service-account JSON file kept OUTSIDE this repo.
# Unused today (nothing calls Firebase Admin). Documented for the planned
# token-verification work. In production (e.g. Google Cloud) leave this unset
# and rely on the platform's own default credentials instead.
GOOGLE_APPLICATION_CREDENTIALS=
# Shared secret for the x-admin-token request header. Empty or absent disables
# every admin-gated route with 503. Set a long random value to enable them.
ADMIN_TOKEN=
