PORT=5000
DB_USER=
DB_PW=
# MongoDB connection. Either give the whole string as MONGO_URI, or leave it
# empty and the server builds one from DB_USER, DB_PW and MONGO_CLUSTER.
MONGO_URI=
# Atlas host. Leave empty to use the built-in default (the cluster this
# project has always used). Set it when moving clusters instead of editing
# source.
MONGO_CLUSTER=
# Absolute path to a Firebase service-account JSON file kept OUTSIDE this repo.
# Used to verify Authorization: Bearer ID tokens. On Google Cloud leave this
# unset and rely on the platform's own default credentials instead.
GOOGLE_APPLICATION_CREDENTIALS=
# The same service-account key JSON as a single-line string, for hosts that
# hold no key file (Vercel). Leave empty when GOOGLE_APPLICATION_CREDENTIALS
# or Application Default Credentials cover the deployment.
FIREBASE_SERVICE_ACCOUNT=
# Shared secret for the x-admin-token request header. Empty or absent disables
# every admin-gated route with 503. Set a long random value to enable them.
ADMIN_TOKEN=
# Requests allowed per client address per minute. Default 120. Health checks
# (GET /) are exempt. Lower it in tests to prove the limiter fires.
RATE_LIMIT_MAX=120
